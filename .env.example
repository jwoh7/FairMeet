# ─────────────────────────────────────────────────────────────
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋하지 않습니다.
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
# ─────────────────────────────────────────────────────────────

# 그룹 가명(HMAC) 생성용 비밀키 — 팀마다 새로 생성할 것
#   생성: python -c "import secrets; print(secrets.token_hex(32))"
FAIRMEET_GROUP_SECRET=change-me-to-a-random-64-char-hex

# 에이전트 ↔ 중재자 인증용 공유 Bearer 토큰
#   생성: python -c "import secrets; print(secrets.token_hex(24))"
FAIRMEET_AGENT_TOKEN=change-me-too

# ── 중재자 ──────────────────────────────────────────────────
FAIRMEET_DB=fairmeet.db
FAIRMEET_MEDIATOR_URL=http://127.0.0.1:8000
FAIRMEET_APPROVAL_TTL_MIN=30
FAIRMEET_MAX_ROUNDS=3
FAIRMEET_GROUP_ID=demo-team

# 잔액 가중치. 클수록 과거 양보를 더 강하게 보정한다.
FAIRMEET_LAMBDA_WORK=0.6
FAIRMEET_LAMBDA_SOCIAL=1.0

# ── 승인 재협상 ──────────────────────────────────────────────
# 누군가 거절하면 다음 후보로 다시 제안한다. 그 '사람 승인 라운드'의 최대 횟수.
# 실제 반복 횟수는 min(남은 후보 수, 이 값) 을 넘지 않는다. 비우면 기본값(3).
FAIRMEET_MAX_APPROVAL_ROUNDS=

# ── 승인 요청 이메일 ─────────────────────────────────────────
# 발송 방식:  smtp    실제 이메일 발송 (TLS 필수)
#             console 발송하지 않고 서버 로그에만 남김 (개발용, 기본값)
#             fake    발송하지 않음 (테스트용)
# console 이면 대시보드에는 '발송됨'으로 보여도 실제 메일은 가지 않는다.
FAIRMEET_EMAIL_BACKEND=

# 이메일 속 승인 링크의 기준 주소. 받는 사람의 기기에서 열 수 있는 주소여야 한다.
# 비우면 FAIRMEET_MEDIATOR_URL(기본 localhost)을 쓰는데, localhost 는 내 컴퓨터에서만
# 열리므로 다른 사람에게 보내는 실제 메일에는 쓸 수 없다. 자세한 내용은 README 참고.
# 예시 형태:  https://<공개 도메인>   (끝에 / 를 붙이지 않는다)
FAIRMEET_PUBLIC_BASE_URL=

# SMTP 설정 (FAIRMEET_EMAIL_BACKEND=smtp 일 때만 사용)
#   HOST      SMTP 서버 주소
#   PORT      587 (STARTTLS) 또는 465 (처음부터 SSL). 비우면 587. 평문(25)은 지원하지 않는다.
#   USERNAME  로그인 아이디 (Gmail 은 전체 이메일 주소)
#   PASSWORD  비밀번호. Gmail 은 계정 비밀번호가 아니라 '앱 비밀번호'. 절대 커밋하지 않는다.
#   FROM      보내는 사람 표시 주소
FAIRMEET_SMTP_HOST=
FAIRMEET_SMTP_PORT=
FAIRMEET_SMTP_USERNAME=
FAIRMEET_SMTP_PASSWORD=
FAIRMEET_SMTP_FROM=

# ── 선택: LLM (자연어 회의 조건 · PDF 분석) ───────────────────────────
# Claude Code 로그인과는 별개의 과금 경로입니다. 비워 두면 LLM 을 쓰지 않습니다.
ANTHROPIC_API_KEY=

# ── 선택: Slack 승인 ────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ── 선택: 자연어 회의 조건 · 회의 자료 분석 (LLM) ─────────────────────────────
# FAIRMEET_NL_BACKEND: auto(키가 있으면 LLM, 없으면 규칙 기반) | rules(외부 호출 없음) | llm
# LLM 결과는 항상 서버가 다시 검증하고, 사용자가 확인하기 전에는 협상이 시작되지 않습니다.
# LLM 이 없거나 실패해도 규칙 기반 해석과 수동 협상은 그대로 동작합니다.
FAIRMEET_NL_BACKEND=auto
FAIRMEET_LLM_MODEL=claude-opus-5
FAIRMEET_LLM_TIMEOUT_S=30
FAIRMEET_LLM_MAX_TOKENS=2048
FAIRMEET_NL_MAX_CHARS=1000
FAIRMEET_DRAFT_TTL_MIN=60

# ── 확정된 회의의 일정 변경 ────────────────────────────────────────────────
# 변경 투표/요청 링크 유효 시간(분, 회의 시작 시각을 넘지 않음), 재협상이 새 시간을 찾을 기간(일)
FAIRMEET_CHANGE_TTL_MIN=1440
FAIRMEET_CHANGE_SEARCH_DAYS=14

# ── 선택: 회의 준비 — PDF 자료 다중 에이전트 분석 (일정 협상과 독립) ────────────────
# 0 으로 끄면 /prep 라우트가 붙지 않습니다. pip install pypdf 가 필요합니다.
FAIRMEET_PREP_ENABLED=1
FAIRMEET_PREP_MAX_BYTES=5242880
FAIRMEET_PREP_MAX_PAGES=30
FAIRMEET_PREP_MAX_CHARS=60000
# 비우면 FAIRMEET_LLM_MODEL 을 씁니다.
FAIRMEET_PREP_MODEL=
# 반박 라운드 수(0~3), 호출당 출력 토큰 상한, 분석 1건의 총 토큰 예산(추정), 제한 시간(초)
FAIRMEET_PREP_ROUNDS=1
FAIRMEET_PREP_MAX_TOKENS=3000
FAIRMEET_PREP_TOKEN_BUDGET=80000
FAIRMEET_PREP_TIMEOUT_S=120

# ── 관리자 로그인 · 공개(터널) 보안 ──────────────────────────────────────────
# 대시보드와 관리자 API 는 로그인한 관리자만 씁니다. 아래 두 줄은 직접 쓰지 말고 다음 명령으로 채우세요:
#   python -m scripts.set_admin_password
# (비밀번호는 입력해도 화면·파일에 남지 않고, .env 에는 해시만 기록됩니다. 기본 비밀번호는 없습니다.)
# 둘 다 비어 있으면 '로컬 전용 모드'입니다: 이 컴퓨터에서 직접 접속한 요청만 관리자 기능을 쓸 수 있고,
# 터널(Cloudflare)을 거친 요청은 전부 거절됩니다. 터널로 공개하기 전에 반드시 설정하세요.
FAIRMEET_ADMIN_USER=
FAIRMEET_ADMIN_PASSWORD_HASH=
# 로그인 유지 최대 시간(분) / 조작이 없으면 로그아웃되는 시간(분) / 보안 감사 기록 보관 기간(일)
FAIRMEET_ADMIN_SESSION_MIN=480
FAIRMEET_ADMIN_IDLE_MIN=30
FAIRMEET_SECURITY_LOG_DAYS=30

# ── 회의 자료 공유 ──────────────────────────────────────────────────────────
# 참석자에게 보내는 자료 열람 링크의 유효 시간(시간), 분석 결과 보관 기간(일). PDF 원본은 저장하지 않습니다.
FAIRMEET_MATERIAL_LINK_TTL_H=72
FAIRMEET_MATERIAL_RETENTION_DAYS=14